<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dispatch_list" model="ir.ui.view">
        <field name="name">alvina.branch.dispatch.list</field>
        <field name="model">alvina.branch.dispatch</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/><field name="issued_date"/><field name="branch_id"/>
                <field name="buyer_company_id"/><field name="receipt_state"/><field name="confirmed_date"/>
            </list>
        </field>
    </record>
    <record id="view_dispatch_form" model="ir.ui.view">
        <field name="name">alvina.branch.dispatch.form</field>
        <field name="model">alvina.branch.dispatch</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <field name="can_receive" invisible="True"/>
                    <button name="action_open_receipt" string="Confirmar recepción real" type="object" class="btn-primary" invisible="not can_receive" groups="alvina_branch_requisition.group_requester"/>
                    <button name="action_print" string="Imprimir guía valorizada" type="object"/>
                    <field name="receipt_state" widget="statusbar"/>
                </header>
                <sheet><h1><field name="name"/></h1>
                    <group>
                        <group><field name="branch_id" options="{'no_open': True}"/><field name="buyer_company_id" options="{'no_open': True}"/><field name="request_id" options="{'no_open': True}"/></group>
                        <group><field name="company_id" options="{'no_open': True}"/><field name="issued_date"/><field name="issued_by" options="{'no_open': True}"/></group>
                    </group>
                    <p>Esta guía corresponde a un despacho físico validado. La recepción se confirma con las cantidades reales; los faltantes por despachar y las diferencias de recepción son saldos distintos.</p>
                    <field name="line_ids"><list create="0" edit="0" delete="0">
                        <field name="description"/><field name="product_uom_id" options="{'no_open': True}"/>
                        <field name="quantity"/><field name="qty_received"/><field name="qty_difference"/>
                        <field name="price_unit"/><field name="amount_total"/><field name="currency_id" column_invisible="True"/>
                    </list></field>
                    <group string="Confirmación registrada" invisible="receipt_state == 'pending'">
                        <field name="confirmed_by" options="{'no_open': True}"/><field name="confirmed_date"/><field name="receipt_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dispatch_notes" model="ir.actions.act_window">
        <field name="name">Guías internas y recepción</field>
        <field name="res_model">alvina.branch.dispatch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>
    <menuitem id="menu_dispatch_notes" name="Guías internas y recepción" parent="purchase.menu_procurement_management" action="action_dispatch_notes" sequence="35" groups="alvina_branch_requisition.group_requester"/>
    <record id="view_dispatch_receipt_form" model="ir.ui.view">
        <field name="name">alvina.branch.dispatch.receipt.form</field>
        <field name="model">alvina.branch.dispatch.receipt</field>
        <field name="arch" type="xml">
            <form string="Confirmar recepción real">
                <group><field name="dispatch_id" options="{'no_open': True}"/></group>
                <p>Ingrese lo que recibió físicamente. Confirmar registra la recepción de Inventario y su conformidad en una sola operación. No copie lo enviado si recibió menos.</p>
                <field name="line_ids"><list editable="bottom" create="0" delete="0">
                    <field name="dispatch_line_id" column_invisible="True" force_save="1"/>
                    <field name="product_name"/><field name="product_uom_id" options="{'no_open': True}"/>
                    <field name="shipped"/><field name="quantity"/>
                </list></field>
                <field name="note" placeholder="Obligatorio si recibió una cantidad diferente a la despachada"/>
                <footer><button name="action_confirm" type="object" string="Confirmar recepción" class="btn-primary"/><button string="Cancelar" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
    <record id="view_picking_dispatch_note" model="ir.ui.view">
        <field name="name">stock.picking.form.alvina.dispatch.note</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="alvina_branch_requisition.view_picking_form_alvina_dispatch_notes"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='alvina_dispatch_notes']/group" position="inside">
                <field name="alvina_emitted_dispatch_ids" readonly="1"/>
                <field name="alvina_dispatch_id" options="{'no_create': True}" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
