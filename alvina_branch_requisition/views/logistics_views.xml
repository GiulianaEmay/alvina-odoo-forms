<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_logistics_branch_sales" model="ir.actions.act_window">
        <field name="name">Pedidos de sucursales</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('alvina_branch_request_id.supply_flow', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p>Las solicitudes de las sucursales generan aquí las órdenes de venta de Industria
               cuando el flujo de abastecimiento está configurado y activo.</p>
        </field>
    </record>
    <menuitem id="menu_logistics_branch_sales" name="Pedidos de sucursales"
              parent="sale.sale_order_menu" action="action_logistics_branch_sales"
              groups="alvina_branch_requisition.group_industry_logistics" sequence="5"/>
</odoo>
