<?xml version="1.0" ?>
<odoo>
    <record id="rule_binding_scope" model="ir.rule">
        <field name="name">Alviña: sucursales autorizadas</field>
        <field name="model_id" ref="model_alvina_branch_binding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)] if user.has_group('alvina_branch_requisition.group_admin') else [('company_id', 'in', company_ids), ('user_ids', 'in', user.id)]</field>
    </record>
    <record id="rule_request_scope" model="ir.rule">
        <field name="name">Alviña: compañía y sucursales asignadas</field>
        <field name="model_id" ref="model_alvina_branch_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('branch_id.user_ids', 'in', user.id)]</field>
    </record>
    <record id="rule_request_line_scope" model="ir.rule">
        <field name="name">Alviña: compañía y sucursales asignadas</field>
        <field name="model_id" ref="model_alvina_branch_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('branch_id.user_ids', 'in', user.id)]</field>
    </record>
</odoo>
