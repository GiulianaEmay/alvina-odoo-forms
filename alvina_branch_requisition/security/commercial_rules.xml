<odoo>
    <record id="rule_supply_sales_assignment" model="ir.rule">
        <field name="name">Alviña: ventas vinculadas de sucursales asignadas</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">['|', ('alvina_branch_request_id', '=', False), ('alvina_branch_request_id.branch_id.user_ids', 'in', user.id)]</field>
    </record>
    <record id="rule_supply_purchases_assignment" model="ir.rule">
        <field name="name">Alviña: compras vinculadas de sucursales asignadas</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">['|', ('alvina_branch_request_id', '=', False), ('alvina_branch_request_id.branch_id.user_ids', 'in', user.id)]</field>
    </record>
    <record id="rule_supply_sales_lines_assignment" model="ir.rule">
        <field name="name">Alviña: líneas de ventas de sucursales asignadas</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">['|', ('order_id.alvina_branch_request_id', '=', False), ('order_id.alvina_branch_request_id.branch_id.user_ids', 'in', user.id)]</field>
    </record>
    <record id="rule_supply_purchase_lines_assignment" model="ir.rule">
        <field name="name">Alviña: líneas de compras de sucursales asignadas</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="domain_force">['|', ('order_id.alvina_branch_request_id', '=', False), ('order_id.alvina_branch_request_id.branch_id.user_ids', 'in', user.id)]</field>
    </record>
    <record id="rule_supply_configuration_company" model="ir.rule">
        <field name="name">Alviña: configurar Industria desde su compañía</field>
        <field name="model_id" ref="model_alvina_supply_configuration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_balance_cancellation_assignment" model="ir.rule">
        <field name="name">Alviña: cierres de saldo de sucursales asignadas</field>
        <field name="model_id" ref="model_alvina_branch_balance_cancellation"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('request_line_id.branch_id.user_ids', 'in', user.id)]</field>
    </record>
</odoo>
