<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_balance_cancellation_form" model="ir.ui.view">
        <field name="name">alvina.branch.balance.cancellation.form</field>
        <field name="model">alvina.branch.balance.cancellation</field>
        <field name="arch" type="xml">
            <form string="Cerrar saldo con motivo" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="request_line_id" force_save="1" options="{'no_open': True}"/>
                        <field name="quantity"/>
                        <field name="reason" placeholder="Explique por qué el faltante ya no se atenderá"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Registrar cierre" special="save" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_picking_form_alvina_dispatch_notes" model="ir.ui.view">
        <field name="name">stock.picking.form.alvina.dispatch.notes</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='note']" position="after">
                <page string="Despacho Alviña" name="alvina_dispatch_notes">
                    <group>
                        <field name="alvina_request_ids" widget="many2many_tags" options="{'no_open': True}"/>
                        <field name="alvina_branch_names"/>
                        <field name="alvina_dispatch_note" placeholder="Observaciones de la preparación y entrega"/>
                        <field name="alvina_shortage_note" placeholder="Indique por qué no se entregó la cantidad completa"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
